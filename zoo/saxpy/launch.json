{
  "name": "saxpy",
  "source": "kernel.cu",
  "entry": "saxpy<{T}>",
  "dtypes": ["float32", "float16", "bfloat16"],
  "params": [
    {"name": "n", "kind": "scalar", "dtype": "int32", "value": "n"},
    {"name": "a", "kind": "scalar", "dtype": "float32", "value": "a"},
    {"name": "x", "kind": "input", "dtype": "T", "shape": ["n"]},
    {"name": "y", "kind": "inout", "dtype": "T", "shape": ["n"]}
  ],
  "launch": {"grid": ["cdiv(n, 256)"], "block": [256], "shared_mem": 0},
  "cases": [
    {"name": "tiny_1", "dims": {"n": 1, "a": 2.5}},
    {"name": "tiny_7", "dims": {"n": 7, "a": -1.5}},
    {"name": "odd_1000", "dims": {"n": 1000, "a": 2.5}},
    {"name": "odd_1023", "dims": {"n": 1023, "a": 0.0}},
    {"name": "odd_4097", "dims": {"n": 4097, "a": -3.25}},
    {"name": "pow2_65536", "dims": {"n": 65536, "a": 2.5}},
    {"name": "large_16M", "dims": {"n": 16777216, "a": 2.5}}
  ],
  "init": {"x": {"dist": "normal", "edges": true}, "y": {"dist": "normal"}},
  "bench_case": "large_16M"
}
